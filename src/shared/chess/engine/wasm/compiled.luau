local stack_pool = {
	[16] = {},
	[64] = {},
	[256] = {},
	[1024] = {},
	[4096] = {},
	[16384] = {},
}

local function stack_acquire(size_class: number)
	local stack = table.remove(stack_pool[size_class])

	return if stack == nil then table.create(size_class) else stack
end

local function stack_release(size_class: number, stack)
	table.insert(stack_pool[size_class], stack)
end

local function rt_memory_new(initializer: { string }, size: number): buffer?
	local ok, data = pcall(buffer.create, size)

	if not ok then
		return nil
	end

	for offset, content in initializer do
		buffer.writestring(data, offset, content)
	end

	return data
end

local rt_export_map: { [string]: any } = {}

local function rt_export(identifier: string, value: any)
	rt_export_map[identifier] = value
end

